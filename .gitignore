node_modules
dist
.next
.turbo
# Environment files — ignore all, keep only *.example templates
.env
.env.*
!.env.example
!.env.*.example
*.log
uploads
coverage

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Prisma generated client output (regenerated by `prisma generate`)
# NOTE: the clients live at packages/<pkg>/src/generated — the old
# `packages/*/generated/` pattern missed the `src/` segment and never matched.
packages/*/src/generated/
packages/*/generated/
packages/*/.prisma/

# TypeScript incremental build info — machine-specific, changes on every build
*.tsbuildinfo

# Local scratch scripts and throwaway artefacts. These are one-off helpers used
# while building a slice; they are intentionally not shared. The run-book scripts
# below are re-included so they stay available to commit if we choose to.
/verify-*.sh
/verify-*.py
/check-*.sh
/smoke-*.sh
/setup-*.sh
/seed-*.sh
/seed-*.py
/teardown-*.sh
/bringup-*.sh
/repro-*.sh
/debug-*.sh
/fix-*.sh
/restore-*.py
/run-verify-*.sh
/build-run-api.sh
/ps-backend.sh
/restart-api.sh
/shutdown-local.sh
/totp-code.sh
/ticket-flow-diagram.*
/AssetMon-Admin-Panel-Feature-Report.pdf

# Local run-book scripts — useful day to day, but machine-specific, so they stay
# out of the shared repo.
/hold-backend.sh
/rebuild-api-local.sh

# Local agent / editor tooling config
.agents/
.claude/

# Research and one-off reports kept locally. Listed by name on purpose: build
# specs under docs/ are still expected to be committed with their slice, so this
# must not become a blanket docs/ rule.
/docs/admin-panel-slice7b-build.md
/docs/deployment-fly-vs-aws.md
/docs/snipeit-analysis-report.md
