# =============================================================================
# AssetMon — environment template
# =============================================================================
# Copy this file to `.env` on each machine and fill in real values.
# `.env` itself is gitignored; never commit secrets.
# =============================================================================

# --- Database (MySQL) ---------------------------------------------------------
# ONE database holds everything. Catalog data (tenants, platform operators) and
# tenant data (assets, users, tickets) live in the same schema, separated by a
# `tenantId` column rather than by separate databases.
#
# Used by the mysql service in docker-compose.yml:
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=assetmon
#
# Used by the API. Host is the compose service name in Docker, localhost otherwise.
DATABASE_URL=mysql://root:change_me@mysql:3306/assetmon
#
# CATALOG_DATABASE_URL is a legacy alias kept because ~20 services still inject
# CatalogPrismaService. It MUST point at the same database as DATABASE_URL — the
# two clients are now the same instance, and pointing them apart would silently
# read tenants from one database and their data from another.
CATALOG_DATABASE_URL=mysql://root:change_me@mysql:3306/assetmon

# --- Auth ---------------------------------------------------------------------
# Generate strong secrets in production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_long_random_string
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- API ----------------------------------------------------------------------
API_PORT=4000
# Comma-separated list of allowed browser origins (CORS + CSP connect-src).
WEB_ORIGIN=http://localhost:4001,http://127.0.0.1:4001

# --- Web ----------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Uploads (local filesystem for MVP) ---------------------------------------
UPLOAD_DIR=./uploads

# --- SMTP (leave empty in dev to use stream transport — captured to EmailLog) -
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AssetMon <no-reply@assetmon.local>

# --- Razorpay (leave empty for dev/test — plan changes flip immediately) ------
# In production set keys + webhook secret + plan IDs from the Razorpay dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_BUSINESS=
RAZORPAY_PLAN_ENTERPRISE=
