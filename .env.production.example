# =====================================================================
# AssetMon - PRODUCTION env template.
#
# Target: Hostinger Node.js app hosting + the MariaDB that comes with the plan.
# Docker is LOCAL ONLY (docker-compose.yml) — it is not how this deploys.
#
# Copy to ".env" on the server, fill in real values. NEVER commit ".env".
# =====================================================================
NODE_ENV=production
API_PORT=4000

# --- Database (MariaDB, provided by the hosting plan) -------------------
# One database holds everything; tenants are separated by a `tenantId` column.
#
# The API runs on the same host as the database, so this is a local connection —
# no Remote MySQL, no IP allowlist needed for the app itself. Use the database
# name, user and password exactly as shown in hPanel > Databases > Management.
#
# Verified against MariaDB 11.8.8, which is what the plan runs.
DATABASE_URL=mysql://DBUSER:DBPASSWORD@localhost:3306/DBNAME
#
# Legacy alias, still injected by ~20 services. MUST address the SAME database.
CATALOG_DATABASE_URL=mysql://DBUSER:DBPASSWORD@localhost:3306/DBNAME


# --- Legacy Postgres (migration source only; delete after cutover) -----
# Only needed to run consolidate-data.ts / verify-integrity.ts against the old
# database-per-tenant instance. The application never reads these.
# POSTGRES_URL=postgresql://postgres:OLD_PASSWORD@postgres:5432

# --- Auth secrets - generate EACH with:  openssl rand -hex 32 ---
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_32_distinct
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32_distinct
# MFA (platform 3FA + tenant). Required in production, NO fallback.
# ALL FIVE secrets here must be DISTINCT from one another.
JWT_MFA_TICKET_SECRET=CHANGE_ME_openssl_rand_hex_32_distinct
OTP_PEPPER=CHANGE_ME_openssl_rand_hex_32_distinct
# Bump this (to 2, 3, ...) whenever you rotate OTP_PEPPER; old backup codes then
# auto-retire and users are forced to regenerate on next login. Default: 1.
OTP_PEPPER_VERSION=1
# Break-glass: REQUIRED to run the host CLI `--reset-mfa` (recover a locked-out
# operator). Keep this OUT of app automation and store it separately from the DB
# credentials, so DB access alone cannot reset an operator's MFA.
BREAKGLASS_TOKEN=CHANGE_ME_openssl_rand_hex_32
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- CORS / proxy ---
# Exact Vercel frontend origin(s), comma-separated.
WEB_ORIGIN=https://app.yourco.com
TRUST_PROXY_HOPS=1

# --- Uploads (Linux path; mapped to the "uploads" Docker volume) ---
UPLOAD_DIR=/app/uploads

# --- OPTIONAL: email. Leave blank to log emails instead of sending them. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AssetMon <no-reply@yourco.com>

# --- OPTIONAL: Razorpay payments. Leave blank for billing dev/free mode. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_BUSINESS=
RAZORPAY_PLAN_ENTERPRISE=

# NOTE: NEXT_PUBLIC_API_URL and NEXT_PUBLIC_SITE_URL are NOT set here -
# they belong on Vercel (frontend), set at build time.
